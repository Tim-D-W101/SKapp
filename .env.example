# Copy to .env and fill in. Never commit .env.
# Only EXPO_PUBLIC_* variables may be referenced from app code.
# The Gemini API key and the Supabase service role key are NOT listed here
# on purpose — they live only in Supabase Edge Function secrets.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Public web pages for the Terms and the Privacy Policy (Phase 12). The
# paywall links to both, and the stores require it.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
