# Copy to .env and fill in. Never commit .env.
# Only EXPO_PUBLIC_* variables may be referenced from app code.
# The Gemini API key and the Supabase service role key are NOT listed here
# on purpose — they live only in Supabase Edge Function secrets.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Analytics and crash reporting (README > Analytics and crash reporting).
# The PostHog host is your project's region: https://eu.i.posthog.com or
# https://us.i.posthog.com.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_SENTRY_DSN=

# Public web pages for the Terms and the Privacy Policy (Phase 12). The
# paywall links to both, and the stores require it.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# The support address Settings links to, and where data requests go.
EXPO_PUBLIC_SUPPORT_EMAIL=
